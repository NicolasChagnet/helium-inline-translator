{
  "manifest_version": 3,
  "name": "Helium Inline Translator",
  "default_locale": "en",
  "version": "1.2.0",
  "description": "__MSG_appDesc__",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Shift+Alt+W",
        "mac": "MacCtrl+P"
      },
      "description": "Translate the whole page"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Shift+Alt+Q",
        "mac": "MacCtrl+S"
      },
      "description": "Translate the selected text"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
